{
  "redirects": [
    { "source": "/", "has": [{ "type": "host", "value": "www.c2dterminal.com" }], "destination": "https://c2dterminal.com/", "permanent": true },
    { "source": "/:path+", "has": [{ "type": "host", "value": "www.c2dterminal.com" }], "destination": "https://c2dterminal.com/:path+", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
