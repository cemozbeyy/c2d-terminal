# Xcode / generated project (regenerate with `xcodegen generate`)
*.xcodeproj
# App/Info.plist is written by xcodegen from project.yml `info:`
App/Info.plist
*.xcworkspace
xcuserdata/
DerivedData/
build/
*.xcresult

# Swift Package Manager
.build/
.swiftpm/
Packages/*/.build/

# Signing material and secrets — never commit
*.p12
*.cer
*.certSigningRequest
*.mobileprovision
*.provisionprofile
*.keychain*
.env
.env.*
*.pem
*.key

# Local machine / editor
.DS_Store
.idea/
.vscode/
*.swp
*.log

# Private product/design docs: kept locally, never published
docs/

# Vercel CLI link (Website/)
.vercel
